# Optional — the app ships with working defaults (public anon key) for the
# shared NAWEMEDIA Supabase project, so these are only needed to point at a
# different project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required — service account used by /api/drive-sync to copy every onboarding
# submission (data + files) into a Google Drive folder, one subfolder per DJ.
# Create the service account in Google Cloud Console (Drive API enabled),
# download its JSON key, and share DRIVE_ONBOARDING_FOLDER_ID with its email
# (Editor access). Paste the private key's PEM block as-is (with real
# newlines); Vercel's env var UI accepts multi-line values directly.
GOOGLE_SERVICE_ACCOUNT_EMAIL=onboarding-drive-sync@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
DRIVE_ONBOARDING_FOLDER_ID=your-drive-folder-id
