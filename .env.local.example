# Optional — the app ships with working defaults (public anon key) for the
# shared NAWEMEDIA Supabase project, so these are only needed to point at a
# different project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required — /api/drive-sync copies every onboarding submission (data + files)
# into a Google Drive folder, one subfolder per DJ, by forwarding the payload
# to a Google Apps Script Web App deployed by the Drive account owner. Service
# accounts can't write to a personal (non-Workspace) Drive — not even via a
# shared folder — so a Web App that runs as the real account is the fix.
# See apps-script/drive-sync.gs for the script to deploy.
DRIVE_SYNC_WEBAPP_URL=https://script.google.com/macros/s/your-deployment-id/exec
DRIVE_SYNC_WEBAPP_SECRET=a-long-random-string-you-choose
